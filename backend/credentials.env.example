# Credentials for the image workbench backend.
#
# Copy this file to `credentials.env` and fill in the providers you actually use.
# `credentials.env` is gitignored — never commit it.
#
#   cp backend/credentials.env.example backend/credentials.env
#   chmod 600 backend/credentials.env
#
# Leave a value as REPLACE_ME (or empty) to keep that channel disabled; the
# backend treats REPLACE_ME as "not configured" rather than sending a bogus key.
# Environment variables of the same name take priority over this file.

# ModelScope 魔搭 — free. https://modelscope.cn (API-Inference token)
MODELSCOPE_API_TOKEN=REPLACE_ME

# SenseNova 商汤日日新 — PAID, billed in tokens. Leave blank to never call it.
# https://platform.sensenova.cn
SENSENOVA_API_KEY=REPLACE_ME

# Pollinations — free. https://enter.pollinations.ai
POLLINATIONS_API_KEY=REPLACE_ME

# Cloudflare Workers AI — free tier. https://dash.cloudflare.com
CLOUDFLARE_API_TOKEN=REPLACE_ME
CLOUDFLARE_ACCOUNT_ID=REPLACE_ME
